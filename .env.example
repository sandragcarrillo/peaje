# ---- gateway ----
PORT=8787
# openssl rand -base64 32
MPP_SECRET_KEY=
# Treasury de Peaje (testnet): recibe el 2% de Tempo y los cobros de planes,
# y paga el gas de los barridos de agentes. Ya no guarda plata de negocios.
TREASURY_ADDRESS=0x...
TREASURY_PRIVATE_KEY=0x...

# ---- pagos directos: PeajeSettlementV3 (docs/pagos-directos.md) ----
# Relayer: EOA nueva, distinta de la treasury, con solo gas nativo, habilitada
# en el contrato. Sin ella los rieles de Arbitrum, Robinhood y Arc no ofrecen nada.
RELAYER_PRIVATE_KEY=
# Una dirección por red. Sin dirección (o "off") esa red no aparece en el 402.
PEAJE_SETTLEMENT_V3_ARBITRUM_SEPOLIA=
PEAJE_SETTLEMENT_V3_ROBINHOOD_TESTNET=
PEAJE_SETTLEMENT_V3_ARC_TESTNET=
# Mainnet: se validan pero el gateway no las usa todavía.
# PEAJE_SETTLEMENT_V3_ARBITRUM_ONE=
# PEAJE_SETTLEMENT_V3_ROBINHOOD_MAINNET=
# PEAJE_SETTLEMENT_V3_ARC_MAINNET=
# Circle Nanopayments: apagado. Junta los pagos en la treasury y obliga a retirar.
# CIRCLE_NANOPAYMENTS_ENABLED=true
# Reembolsos de Tempo desde la treasury cuando el origen falla después de cobrar (USD).
# TEMPO_REFUND_MAX_USD=1.00
# TEMPO_REFUND_DAILY_USD=5.00
# TEMPO_REFUND_GLOBAL_DAILY_USD=20.00
# Corte por origen caído: N fallos en M minutos apagan el 402 del negocio por un rato.
# ORIGIN_BREAKER_FAILURES=3
# ORIGIN_BREAKER_WINDOW_MINUTES=10
# ORIGIN_BREAKER_COOLDOWN_MINUTES=15
# Token TIP-20 (pathUSD en Tempo)
MPP_CURRENCY=0x20c0000000000000000000000000000000000000
TEMPO_NETWORK=testnet
# RPC de Arc (opcional; default: rpc.testnet.arc.io). En Arc el gas es USDC:
# fondea el relayer en https://faucet.circle.com (red Arc Testnet).
# ARC_RPC_URL=
# Depeg guard (Chainlink USDC/USD en Ethereum mainnet). Con USDC bajo
# 1 - DEPEG_THRESHOLD_BPS/10000, el rail de Arc se pausa. Ambas opcionales.
# CHAINLINK_RPC_URL=https://ethereum-rpc.publicnode.com
# DEPEG_THRESHOLD_BPS=50

# ---- supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- dashboard ----
# Secreto compartido entre dashboard y gateway para la API interna (/_internal/*).
INTERNAL_API_SECRET=
# URL del gateway que el server del dashboard llama (ledger, retiros).
GATEWAY_INTERNAL_URL=http://localhost:8787
# URL del gateway que se le muestra al usuario en el browser.
GATEWAY_PUBLIC_URL=http://localhost:8787
# Mismo valor que GATEWAY_PUBLIC_URL: con prefijo NEXT_PUBLIC_ porque el
# dashboard lo lee en el cliente (Next.js solo expone al browser las vars
# con este prefijo).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787

# ---- Privy (login por email + wallets de merchant) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Autoriza acciones sensibles sobre una wallet (ej. swap, sweep). No usado
# todavía: hoy el dashboard solo crea wallets y lee balances, no mueve fondos.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Mismo valor que PRIVY_APP_ID: es público, lo usa el SDK de cliente para el login OTP.
NEXT_PUBLIC_PRIVY_APP_ID=
# Solo para la migración de app (docs/privy-migracion.md). La vieja es de
# solo lectura salvo en el barrido; borrarlas 30 días después del corte.
PRIVY_VIEJA_APP_ID=
PRIVY_VIEJA_APP_SECRET=
PRIVY_NUEVA_APP_ID=
PRIVY_NUEVA_APP_SECRET=

# ---- sesión del dashboard ----
# Firma la cookie de sesión (HMAC). 32+ bytes aleatorios: openssl rand -base64 48.
# Sin esta variable el dashboard cae a INTERNAL_API_SECRET con un aviso en el log.
SESSION_SECRET=
# Opcional en el dashboard: "usar mi propia dirección" rechaza la treasury.
# El gateway ya la tiene (TREASURY_ADDRESS más arriba no aplica a Vercel).
# TREASURY_ADDRESS=

# ---- embed (roadmap, no implementado — ver docs/EMBED-SPEC.md) ----
EMBED_JWT_ISSUER=

# ---- The Graph (página Clientes: identidad ERC-8004 de agentes) ----
# API key de queries de Subgraph Studio (thegraph.com/studio → API Keys).
# Sin key la página funciona pero sin enriquecer identidades.
GRAPH_API_KEY=

# ---- agente comprador de demo ----
AGENT_PRIVATE_KEY=

# ---- Paddle Billing (suscripción Pro con tarjeta; ver docs/paddle.md) ----
# gateway (Railway): webhook y portal de clientes
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_PRICE_FOUNDER=
PADDLE_PRICE_PRO=
# Cobro de Pro en USDC (402 y saldo). Apagado por defecto: Pro se vende con tarjeta.
# BILLING_CRYPTO_ENABLED=1
# dashboard (Vercel): checkout overlay
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# PADDLE_PRICE_FOUNDER y PADDLE_PRICE_PRO también van en el dashboard (mismos valores).
